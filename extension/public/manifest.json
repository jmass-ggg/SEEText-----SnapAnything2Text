{
  "manifest_version": 3,
  "name": "CodeCapture",
  "version": "0.1.0",
  "description": "Capture and extract content from any visual source.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "index.html"
  }
}